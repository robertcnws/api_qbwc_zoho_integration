{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "ignorePatterns": [
    "node_modules/",
    "build/",
    "dist/",
    "**/*.ts",
    "**/*.tsx"
  ],
  "rules": {
    "no-unused-vars": ["warn", { "varsIgnorePattern": "^_", "argsIgnorePattern": "^_" }],
    "prefer-const": "warn",
    "eqeqeq": ["warn", "smart"],
    "no-trailing-spaces": "warn",
    "object-curly-spacing": ["warn", "always"],
    "semi": ["warn", "always"],
    "quotes": ["warn", "single", { "avoidEscape": true }]
  }
}
